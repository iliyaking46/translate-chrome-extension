{
  "manifest_version": 3,
  "version": "2.1.0",
  "name": "Translate Helper",
  "description": "Easily translate text from websites using built-in AI or Translate.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt + Q",
        "mac": "Alt + Q"
      },
      "description": "Open extension"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting", "activeTab", "contextMenus", "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "options_page": "options.html"
}
